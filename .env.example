# Preencha com o endpoint autorizado que retorna a carteira completa em JSON.
KONSIG_API_URL=
KONSIG_API_TOKEN=
# Chave autorizada para leitura da API Sou+BLU.
SOUMAISBLU_API_KEY=
SYNC_INTERVAL_MS=300000
PORT=3000
# Ao hospedar atrás de proxy HTTPS com autenticação, configure a origem pública.
# PANEL_ORIGIN=https://painel.seudominio.com.br
# SQLite em diretório persistente gravável pelo Node.js. Localmente, usa goals.sqlite.
# GOALS_DB_FILE=/var/lib/blu-painel/goals.sqlite
# Arquivo JSON legado para importação na primeira inicialização do banco.
# GOALS_FILE=/var/lib/blu-painel/metas.json
